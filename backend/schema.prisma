datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// USUARIOS Y ROLES
// ==========================================
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Encriptada con bcrypt
  name      String
  role      Role     @default(CUSTOMER)
  orders    Order[]
  addresses Address[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id         String  @id @default(uuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  street     String
  city       String
  state      String
  postalCode String
  country    String  @default("México")
  isDefault  Boolean @default(false)
}

// ==========================================
// CATÁLOGO DE PRODUCTOS (Moda)
// ==========================================
model Product {
  id          String    @id @default(uuid())
  slug        String    @unique // ej. falda-padel-negra
  title       String
  description String
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  images      Image[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Category {
  id       String    @id @default(uuid())
  slug     String    @unique
  name     String    // ej. "Faldas", "Accesorios"
  products Product[]
}

model Variant {
  id        String      @id @default(uuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  size      String      // ej. "XS", "S", "M", "L"
  color     String      // ej. "Negro"
  hexColor  String?     // ej. "#000000" para mostrar visualmente
  sku       String      @unique
  price     Float
  stock     Int         @default(0)
  orderItem OrderItem[]
}

model Image {
  id        String  @id @default(uuid())
  url       String  // URL del bucket en AWS S3 o Cloudinary
  isMain    Boolean @default(false)
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

// ==========================================
// PEDIDOS Y CARRITO
// ==========================================
model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Float
  status      OrderStatus @default(PENDING)
  paymentId   String?     // ID de transacción de Mercado Pago
  shippingUrl String?     // URL de rastreo de Skydropx
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Float   // Precio histórico al momento de la compra
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
